[Unit]
Description=Raspberry Pi Throttle Monitor
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/usr/local/sbin/monitor/.env
Environment=INTERVAL=60
ExecStart=/usr/local/sbin/monitor/venv/bin/python3 -u /usr/local/sbin/monitor/throttle_monitor.py "$KUMA_TOKEN" "$HOST_IP"
Restart=always
RestartSec=10
